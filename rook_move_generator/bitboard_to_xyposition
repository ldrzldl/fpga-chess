`timescale 1ns / 1ps

module bitboard_to_coord (
    input  wire [24:0] bitboard, // 25비트 체스판 입력
    output reg  [2:0]  pos_x,    // X 좌표 (1 ~ 5)
    output reg  [2:0]  pos_y,    // Y 좌표 (1 ~ 5)
    output reg         valid     // 보드에 기물이 존재하는지 여부
);

    integer i;

    always @(*) begin
        // 1. 초기값 설정 (Latch 방지 및 기물이 없을 때의 예외 처리)
        pos_x = 3'd0;
        pos_y = 3'd0;
        valid = 1'b0;

        // 2. 25비트 레지스터를 순회하며 1이 켜진 위치(Rook의 위치)를 탐색
        for (i = 0; i < 25; i = i + 1) begin
            if (bitboard[i]) begin
                pos_x = (i % 5) + 1; // 인덱스를 X 좌표로 변환
                pos_y = 5 - (i / 5); // 인덱스를 Y 좌표로 변환
                valid = 1'b1;        // 유효한 기물 발견
            end
        end
    end

endmodule